# Sanity content source (public project values; safe to expose in the client).
# Copy to .env.local to override. All VITE_* vars are bundled into the client.
VITE_SANITY_PROJECT_ID=h48br789
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2022-03-07

# Server-only Vercel setting for Studio-facing metadata endpoints. Set this in
# the Vercel project (do not prefix it with VITE_) to allow the deployed Sanity
# Studio to resolve links and YouTube channels.
SANITY_STUDIO_ORIGIN=https://shawkyebrahim.sanity.studio,https://portfolio.sanity.studio

# Server-only Google Cloud credential used by /api/youtube-channel. Enable
# YouTube Data API v3 for the key and restrict it to that API. Never expose this
# value through a VITE_* or SANITY_STUDIO_* variable.
YOUTUBE_DATA_API_KEY=
