# Required for a deployed Studio. This is public configuration, not a secret:
# it is the URL the Studio calls when resolving a pasted link. Set it to the
# portfolio's canonical production domain before running `sanity deploy`.
SANITY_STUDIO_LINK_PREVIEW_ENDPOINT=https://www.shawkyebrahim.me/api/link-preview
SANITY_STUDIO_YOUTUBE_CHANNEL_ENDPOINT=https://www.shawkyebrahim.me/api/youtube-channel
SANITY_STUDIO_IMAGE_IMPORT_ENDPOINT=https://www.shawkyebrahim.me/api/image-import
#
# Local Studio needs no value: link previews use the frontend on port 3000,
# while YouTube Channel metadata uses Vercel Dev on port 3002.
