# Required for a deployed Studio. This is public configuration, not a secret:
# it is the URL the Studio calls when resolving a pasted link. Set it to the
# portfolio's canonical production domain before running `sanity deploy`.
SANITY_STUDIO_LINK_PREVIEW_ENDPOINT=https://www.shawkyebrahim.me/api/link-preview
#
# Local Studio needs no value: it automatically calls
# http://localhost:3000/api/link-preview when Vercel Dev is running.
